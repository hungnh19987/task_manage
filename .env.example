# Supabase PostgreSQL connection string. Use the Session Pooler when the app
# runs continuously; include sslmode=require.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_COOKIE_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Streamlit listens on this port. Change it before installing the service.
STREAMLIT_SERVER_PORT=8501
# Keep localhost when using the included nginx reverse proxy. For direct
# access on a trusted internal network, use 0.0.0.0 and restrict the port
# with the server firewall.
STREAMLIT_SERVER_ADDRESS=127.0.0.1
